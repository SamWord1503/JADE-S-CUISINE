""", unsafe_allow_html=True)

# Password
password = st.text_input("Enter admin password", type="password", placeholder="Password", label_visibility="collapsed")

if password != "Jade2026":
    st.warning("Enter the correct password to access the dashboard.")
    st.stop()

orders = load_orders()

if not orders:
    st.info("No orders yet.")
else:
    today = date.today()
    total_orders = len(orders)
    total_revenue = sum(float(o["total"]) for o in orders)
    todays = [o for o in orders if datetime.strptime(str(o["event_date"]), "%Y-%m-%d").date() == today]
    upcoming = [o for o in orders if datetime.strptime(str(o["event_date"]), "%Y-%m-%d").date() > today]
    past = [o for o in orders if datetime.strptime(str(o["event_date"]), "%Y-%m-%d").date() < today]
    urgent_count = len([o for o in upcoming if (datetime.strptime(str(o["event_date"]), "%Y-%m-%d").date() - today).days <= 3])

    st.markdown(
        "<div class='metric-grid'>"
        "<div class='metric-card'><div class='metric-value'>" + str(total_orders) + "</div><div class='metric-label'>Total Orders</div></div>"
        "<div class='metric-card'><div class='metric-value'>N" + f"{total_revenue:,.0f}" + "</div><div class='metric-label'>Total Revenue</div></div>"
        "<div class='metric-card'><div class='metric-value'>" + str(len(upcoming)) + "</div><div class='metric-label'>Upcoming</div></div>"
        "<div class='metric-card'><div class='metric-value' style='color:#FF6B6B'>" + str(urgent_count) + "</div><div class='metric-label'>Urgent (3 days)</div></div>"
        "</div>",
        unsafe_allow_html=True
    )

    if todays:
        st.markdown("<div class='section-divider'>Today's Events (" + str(len(todays)) + ")</div>", unsafe_allow_html=True)
        for o in todays:
            render_order(o)

    if upcoming:
        st.markdown("<div class='section-divider'>Upcoming Events (" + str(len(upcoming)) + ")</div>", unsafe_allow_html=True)
        for o in upcoming:
            render_order(o)

    if past:
        st.markdown("<div class='section-divider'>Past Events (" + str(len(past)) + ")</div>", unsafe_allow_html=True)
        for o in past:
            render_order(o)

